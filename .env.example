# Secret that keys the audit hash chain. Keep it OUT of the database and the repo. 32+ random chars.
TV_AUDIT_KEY=change-me-to-a-long-random-string
# Role-specific demo passwords (used only when initializing an empty database).
TV_ADMIN_SEED_PASSWORD=TrustVault-Admin-Demo-2026!
TV_OWNER_SEED_PASSWORD=TrustVault-Owner-Demo-2026!
TV_USER_SEED_PASSWORD=TrustVault-User-Demo-2026!
# Where the DB and blobs live (put on a persistent volume)
TV_DB_PATH=data/trustvault.db
TV_STORAGE_DIR=data/blobs
# Set to 1 ONLY for local http development (cookies are Secure by default)
TV_INSECURE_COOKIES=0
# Set to 1 when behind a reverse proxy that sets X-Forwarded-* (so client IPs are right)
TV_TRUST_PROXY=0
TV_MAX_UPLOAD_MB=10
